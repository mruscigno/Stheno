{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STHENO exercise media brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["exerciseSlug", "exerciseName", "equipment", "bodyOrientation", "cameraAngle", "startPosition", "finishPosition", "movementPath", "jointMotion", "stableStructures", "primaryMuscles", "secondaryMuscles", "prohibitedErrors", "visualStyle", "reviewStatus"],
  "properties": {
    "exerciseSlug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "exerciseName": { "type": "string", "minLength": 3 },
    "equipment": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "bodyOrientation": { "type": "string", "minLength": 3 },
    "cameraAngle": { "type": "string", "minLength": 3 },
    "startPosition": { "type": "string", "minLength": 20 },
    "finishPosition": { "type": "string", "minLength": 20 },
    "movementPath": { "type": "string", "minLength": 20 },
    "jointMotion": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "stableStructures": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "primaryMuscles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "secondaryMuscles": { "type": "array", "items": { "type": "string" } },
    "prohibitedErrors": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
    "visualStyle": { "const": "STHENO_BLACK_WHITE_ORANGE_INSTRUCTIONAL" },
    "reviewStatus": { "const": "draft" }
  }
}

