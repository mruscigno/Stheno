{
  "openapi": "3.1.0",
  "info": { "title": "STHENO Mobile Platform API", "version": "1.0.0", "description": "Implemented App 1 API surface. Supabase access tokens are validated server-side." },
  "servers": [{ "url": "https://www.sthenofitness.com" }],
  "components": {
    "securitySchemes": { "supabaseBearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "schemas": {
      "ApiError": { "type": "object", "required": ["apiVersion", "requestId", "error"], "properties": { "apiVersion": { "const": "1.0" }, "requestId": { "type": "string" }, "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": {} } } } },
      "StartWorkout": { "type": "object", "required": ["operationId", "clientSessionKey"], "properties": { "operationId": { "type": "string", "format": "uuid" }, "clientSessionKey": { "type": "string", "format": "uuid" }, "workoutKey": { "type": "string" } } },
      "WorkoutSet": { "type": "object", "required": ["operationId", "exerciseSlug", "setOrdinal", "prescribed", "state"], "properties": { "operationId": { "type": "string", "format": "uuid" }, "baseRevision": { "type": "integer", "minimum": 0 }, "exerciseSlug": { "type": "string" }, "setOrdinal": { "type": "integer", "minimum": 1, "maximum": 20 }, "setType": { "enum": ["warmup", "working", "backoff", "drop", "failure", "optional"] }, "prescribed": { "type": "object" }, "load": { "type": ["number", "null"] }, "loadUnit": { "enum": ["lb", "kg"] }, "repetitions": { "type": ["integer", "null"] }, "rir": { "type": ["number", "null"] }, "rpe": { "type": ["number", "null"] }, "state": { "enum": ["completed", "skipped"] }, "clientTimestamp": { "type": "string", "format": "date-time" } } },
      "CompleteWorkout": { "type": "object", "required": ["operationId", "effort"], "properties": { "operationId": { "type": "string", "format": "uuid" }, "baseRevision": { "type": "integer" }, "effort": { "enum": ["too_easy", "about_right", "very_hard", "couldnt_finish"] }, "note": { "type": "string", "maxLength": 2000 }, "allowIncomplete": { "type": "boolean" } } },
      "MonthlyDecision": { "type": "object", "required": ["operationId", "action"], "properties": { "operationId": { "type": "string", "format": "uuid" }, "action": { "enum": ["apply", "keep"] }, "acceptedIds": { "type": "array", "items": { "type": "string", "format": "uuid" }, "maxItems": 50 } } }
    },
    "responses": { "Unauthorized": { "description": "Missing or invalid member token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }, "Conflict": { "description": "Resource or idempotency conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } } }
  },
  "paths": {
    "/api/v1/exercises": { "get": { "summary": "List production exercise records", "parameters": [{ "name": "cursor", "in": "query", "schema": { "type": "string" } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 } }, { "name": "query", "in": "query", "schema": { "type": "string" } }, { "name": "equipment", "in": "query", "schema": { "type": "string" } }, { "name": "muscle", "in": "query", "schema": { "type": "string" } }, { "name": "pattern", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "Cursor page" } } } },
    "/api/v1/exercises/{id}": { "get": { "summary": "Get exercise and reviewed alternatives", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Exercise detail" }, "404": { "description": "Not found" } } } },
    "/api/v1/me": { "get": { "summary": "Get profile and effective entitlement", "security": [{ "supabaseBearer": [] }], "responses": { "200": { "description": "Member bootstrap" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/api/v1/today": { "get": { "summary": "Get Today read model", "security": [{ "supabaseBearer": [] }], "responses": { "200": { "description": "Today data" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/api/v1/program": { "get": { "summary": "Get current program", "security": [{ "supabaseBearer": [] }], "responses": { "200": { "description": "Current program or null" } } } },
    "/api/v1/nutrition": { "get": { "summary": "Get nutrition read model", "security": [{ "supabaseBearer": [] }], "responses": { "200": { "description": "Nutrition data" } } } },
    "/api/v1/progress": { "get": { "summary": "Get progress read model", "security": [{ "supabaseBearer": [] }], "responses": { "200": { "description": "Progress data" } } } },
    "/api/v1/workouts/sessions": { "post": { "summary": "Start or resume a workout", "security": [{ "supabaseBearer": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StartWorkout" } } } }, "responses": { "200": { "description": "Existing session replay" }, "201": { "description": "Session created" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/api/v1/workouts/sessions/{id}/sets/{setId}": { "put": { "summary": "Replay-safe set upsert", "security": [{ "supabaseBearer": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "setId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkoutSet" } } } }, "responses": { "200": { "description": "Canonical set and operation acknowledgment" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/api/v1/workouts/sessions/{id}/complete": { "post": { "summary": "Replay-safe workout completion", "security": [{ "supabaseBearer": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompleteWorkout" } } } }, "responses": { "200": { "description": "Completion summary" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/api/v1/monthly-reviews": { "get": { "summary": "Get monthly review status and history", "security": [{ "supabaseBearer": [] }], "responses": { "200": { "description": "Review records" } } } },
    "/api/v1/monthly-reviews/{id}/decisions": { "post": { "summary": "Replay-safe selective recommendation decision", "security": [{ "supabaseBearer": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MonthlyDecision" } } } }, "responses": { "200": { "description": "Accepted and declined IDs" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/api/v1/coach/questions": { "post": { "summary": "Ask STHENO Coach", "security": [{ "supabaseBearer": [] }], "responses": { "200": { "description": "Coach response or action proposal" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "503": { "description": "Coach unavailable" } } } }
  }
}
